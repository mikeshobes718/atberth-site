def print_event(event: str, data: str) -> None:
    if JSON:
        try:
            print(json.dumps(json.loads(data), ensure_ascii=False), flush=True)
        except ValueError:
            print(json.dumps({"event": event, "data": data}), flush=True)
        return
    try:
        obj = json.loads(data)
    except ValueError:
        print(f"{event} {data}", flush=True)
        return
    if not isinstance(obj, dict):
        print(f"{event} {cell(obj)}", flush=True)
        return
    kind = obj.get("type") or event
    record = obj.get("record") if obj.get("record") is not None else obj.get("old_record")
    rid = (record or {}).get("id", "") if isinstance(record, dict) else ""
    at = str(obj.get("at") or time.strftime("%Y-%m-%dT%H:%M:%S"))
    print(f"{at}  {kind:<6}  {obj.get('table', '')}  {rid}  {cell(record)}", flush=True)


def cmd_watch(args) -> None:
    app = resolve_app(args)
    signal.signal(signal.SIGINT, signal.default_int_handler)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    query = [("events", args.events)] if args.events else None
    path = app_path(app, "tables", args.table, "stream")
    last_id = None
    announced = False
    try:
        while True:
            headers = {"Accept": "text/event-stream", "Cache-Control": "no-cache"}
            if last_id:
                headers["Last-Event-ID"] = last_id
            resp = app_http(app, "GET", path, query=query, headers=headers, timeout=None, stream=True)
            if not resp.ok:
                fail(resp)
            if not announced:
                note(f"Watching {args.table} in {app}. Press Ctrl-C to stop.")
                announced = True
            event, lines = "message", []
            try:
                for raw in resp.stream:
                    line = raw.decode("utf-8", "replace").rstrip("\r\n")
                    if not line:
                        if lines:
                            print_event(event, "\n".join(lines))
                        event, lines = "message", []
                        continue
                    if line.startswith(":"):
                        continue
                    field, _, value = line.partition(":")
                    value = value[1:] if value.startswith(" ") else value
                    if field == "event":
                        event = value
                    elif field == "data":
                        lines.append(value)
                    elif field == "id":
                        last_id = value
            except (OSError, httpclient.HTTPException):
                pass
            finally:
                resp.stream.close()
            note("The stream closed. Reconnecting.")
            time.sleep(2)
    except KeyboardInterrupt:
        raise SystemExit(0)


