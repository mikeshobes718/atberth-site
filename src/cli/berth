def cmd_functions_invoke(args) -> None:
    app = resolve_app(args)
    method = (args.method or ("POST" if args.data is not None else "GET")).upper()
    query = urllib.parse.parse_qsl(args.path_query.lstrip("?"), keep_blank_values=True) if args.path_query else None
    kw: dict = {"query": query, "headers": {"Accept": "*/*"}, "timeout": 60}
    if args.data is not None:
        kw["data"] = args.data.encode("utf-8")
        kw["ctype"] = args.content_type or "application/json"
    path = app_path(app, "functions", args.name)
    if args.token:
        resp = http(method, path, args.token, **kw)
    else:
        resp = app_http(app, method, path, **kw)
    text = resp.body.decode("utf-8", "replace")
    if not resp.ok:
        data = resp.json()
        if isinstance(data, dict) and data.get("error") and data.get("message"):
            fail(resp)
        if text:
            print(text, file=sys.stderr)
        die(f"The function returned HTTP {resp.status}.")
    data = resp.json() if JSON else None
    if JSON and data is not None:
        show_json(data)
    else:
        sys.stdout.write(text if text.endswith("\n") or not text else text + "\n")


