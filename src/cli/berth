def parse_column_spec(spec: str) -> dict:
    parts = spec.split(":")
    if len(parts) < 2 or not parts[0] or not parts[1]:
        usage(f"Write columns as name:type, for example title:text. Got {spec!r}.")
    col = {"name": parts[0], "type": parts[1]}
    for flag in parts[2:]:
        flag = flag.lower().replace("-", "").replace("_", "")
        if flag == "notnull":
            col["not_null"] = True
        elif flag == "unique":
            col["unique"] = True
        else:
            usage(f"Unknown column flag {flag!r}. Use notnull or unique.")
    return col


def policy_body(read: str | None, write: str | None, current: dict | None = None) -> dict:
    base = dict(current or {"read": "secret", "write": "secret"})
    if read:
        base["read"] = read
    if write:
        base["write"] = write
    return base


