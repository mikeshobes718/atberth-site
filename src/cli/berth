#!/usr/bin/env python3
"""Berth command line. Talks to https://api.atberth.com/v1. Python 3.9+, no extra packages."""

from __future__ import annotations

import argparse
import getpass
from http import client as httpclient
import json
import mimetypes
import os
import re
import shutil
import signal
import socket
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

VERSION = "2.0.0"
DEFAULT_API = "https://api.atberth.com/v1"
FILTER_OPS = ("eq", "neq", "gt", "gte", "lt", "lte", "like", "ilike", "in", "is", "cs")
INT_TYPES = {"integer", "bigint", "int", "int2", "int4", "int8", "smallint"}
NUM_TYPES = {"numeric", "double", "double precision", "real", "float4", "float8", "decimal"}
NUMBER_RE = re.compile(r"^-?\d+(\.\d+)?([eE][-+]?\d+)?$")
RAW_FILTER_RE = re.compile(r"^(not\.)?(" + "|".join(FILTER_OPS) + r")\.")
NOBODY = object()

JSON = False
API_OVERRIDE = None
IDEMPOTENCY_KEY = None
_CFG = None


# Output and errors

def show_json(payload) -> None:
    print(json.dumps(payload, indent=2, ensure_ascii=False), flush=True)


def usage(message: str) -> None:
    print(f"berth: {message}", file=sys.stderr)
    raise SystemExit(2)


def die(message: str, payload: dict | None = None) -> None:
    if JSON:
        show_json(payload or {"error": "cli", "message": message})
    print(f"berth: {message}", file=sys.stderr)
    raise SystemExit(1)


def note(message: str) -> None:
    print(message, file=sys.stderr, flush=True)


def emit(payload, human) -> None:
    if JSON:
        show_json(payload)
    elif callable(human):
        human()
    elif human:
        print(human)


def cell(value) -> str:
    if value is None:
        return ""
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (dict, list)):
        return json.dumps(value, separators=(",", ":"), ensure_ascii=False)
    return str(value)


def clip(text: str, width: int) -> str:
    text = text.replace("\r", " ").replace("\n", " ")
    return text if len(text) <= width else text[: width - 3] + "..."


def print_table(rows: list, columns: list | None = None, empty: str = "Nothing here yet.") -> None:
    rows = [r if isinstance(r, dict) else {"value": r} for r in rows or []]
    if not rows:
        print(empty)
        return
    if columns is None:
        columns = []
        for row in rows:
            for key in row:
                if key not in columns:
                    columns.append(key)
    limit = max(12, min(60, shutil.get_terminal_size((120, 20)).columns // max(1, len(columns))))
    data = [[clip(cell(row.get(col)), limit) for col in columns] for row in rows]
    widths = [max([len(col)] + [len(line[i]) for line in data]) for i, col in enumerate(columns)]
    print("  ".join(col.ljust(w) for col, w in zip(columns, widths)).rstrip())
    for line in data:
        print("  ".join(val.ljust(w) for val, w in zip(line, widths)).rstrip())


def print_kv(obj: dict, indent: str = "", skip: tuple = ()) -> None:
    for key, value in (obj or {}).items():
        if key in skip:
            continue
        if isinstance(value, dict) and value:
            print(f"{indent}{key}:")
            print_kv(value, indent + "  ")
        else:
            print(f"{indent}{key}: {cell(value)}")


def first_list(payload: dict, *keys: str) -> list:
    for key in keys:
        if isinstance(payload.get(key), list):
            return payload[key]
    for value in payload.values():
        if isinstance(value, list):
            return value
    return []


def plural(n: int, word: str) -> str:
    return f"{n} {word}" + ("" if n == 1 else "s")


# Config and credentials

def config_path() -> Path:
    env = os.environ.get("BERTH_CONFIG")
    return Path(env).expanduser() if env else Path.home() / ".config" / "berth" / "config.json"


def cfg() -> dict:
    global _CFG
    if _CFG is not None:
        return _CFG
    path = config_path()
    data: dict = {}
    if path.exists():
        try:
            data = json.loads(path.read_text(encoding="utf-8") or "{}")
        except (OSError, ValueError):
            die(f"Could not read {path}. Fix it or remove it and log in again.")
        if not isinstance(data, dict):
            die(f"Could not read {path}. Fix it or remove it and log in again.")
    data.setdefault("api", DEFAULT_API)
    data.setdefault("token", "")
    if not isinstance(data.get("apps"), dict):
        data["apps"] = {}
    _CFG = data
    return data


def save_config() -> None:
    data = cfg()
    path = config_path()
    existed = path.parent.exists()
    path.parent.mkdir(parents=True, exist_ok=True)
    if not existed or path.parent.name == "berth":
        os.chmod(path.parent, 0o700)
    tmp = path.with_name(path.name + ".tmp")
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(json.dumps(data, indent=2) + "\n")
    os.chmod(tmp, 0o600)
    tmp.replace(path)
    os.chmod(path, 0o600)


def api_base() -> str:
    base = API_OVERRIDE or os.environ.get("BERTH_API") or cfg().get("api") or DEFAULT_API
    return str(base).rstrip("/")


def account_token(required: bool = True) -> str:
    token = os.environ.get("BERTH_TOKEN") or cfg().get("token") or ""
    if not token and required:
        die("Not logged in. Run berth login, or set BERTH_TOKEN.")
    return token


def app_entry(app: str) -> dict:
    value = cfg()["apps"].get(app)
    if isinstance(value, str):
        return {"secret": value}
    return value if isinstance(value, dict) else {}


def app_tokens(app: str) -> list:
    out = []
    for token in (app_entry(app).get("secret"), os.environ.get("BERTH_TOKEN"), cfg().get("token")):
        if token and token not in out:
            out.append(token)
    if not out:
        die(f"No key saved for {app} and not logged in. Run berth login.")
    return out


def save_app_keys(app: str, **keys) -> None:
    entry = app_entry(app)
    for name, value in keys.items():
        if value:
            entry[name] = value
    cfg()["apps"][app] = entry
    save_config()


def forget_app(app: str) -> None:
    data = cfg()
    changed = data["apps"].pop(app, None) is not None
    if data.get("default_app") == app:
        data.pop("default_app")
        changed = True
    if changed:
        save_config()


def resolve_app(args) -> str:
    app = getattr(args, "app", None) or os.environ.get("BERTH_APP") or cfg().get("default_app")
    if not app:
        usage("Pass --app APP, set BERTH_APP, or run berth use APP.")
    return app


def prompt(label: str, secret: bool = False) -> str:
    if sys.stdin.isatty():
        try:
            if secret:
                return getpass.getpass(label).strip()
            print(label, end="", file=sys.stderr, flush=True)
            return input().strip()
        except EOFError:
            return ""
    return sys.stdin.readline().strip()


# HTTP

class Resp:
    def __init__(self, status: int, headers, body: bytes = b"", stream=None):
        self.status = status
        self.headers = headers
        self.body = body
        self.stream = stream

    @property
    def ok(self) -> bool:
        return 200 <= self.status < 300

    def json(self):
        if not self.body:
            return {}
        try:
            return json.loads(self.body.decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            return None


def seg(*parts) -> str:
    return "/" + "/".join(urllib.parse.quote(str(p), safe="") for p in parts)


def app_path(app: str, *parts) -> str:
    return seg("apps", app, *parts)


def http(method: str, path: str, token: str | None = None, *, body=NOBODY, data=None, ctype: str | None = None,
         query: list | None = None, headers: dict | None = None, timeout: float | None = 60.0,
         stream: bool = False) -> Resp:
    url = api_base() + path
    if query:
        url += ("&" if "?" in url else "?") + urllib.parse.urlencode(query, quote_via=urllib.parse.quote)
    for attempt in range(3):
        hdrs = {"Accept": "application/json", "User-Agent": f"berth-cli/{VERSION}"}
        if token:
            hdrs["Authorization"] = "Bearer " + token
        if IDEMPOTENCY_KEY and method != "GET":
            hdrs["Idempotency-Key"] = IDEMPOTENCY_KEY
        payload = None
        fh = None
        if body is not NOBODY:
            payload = json.dumps(body).encode("utf-8")
            hdrs["Content-Type"] = "application/json"
        elif data is not None:
            if isinstance(data, Path):
                fh = data.open("rb")
                payload = fh
                hdrs["Content-Length"] = str(os.fstat(fh.fileno()).st_size)
            else:
                payload = data
            hdrs["Content-Type"] = ctype or "application/octet-stream"
        if headers:
            hdrs.update(headers)
        req = urllib.request.Request(url, data=payload, headers=hdrs, method=method)
        try:
            try:
                res = urllib.request.urlopen(req, timeout=timeout)
            except urllib.error.HTTPError as err:
                res = err
            status = res.getcode()
            if stream and 200 <= status < 300:
                return Resp(status, res.headers, stream=res)
            raw = res.read()
            res.close()
        except (urllib.error.URLError, socket.timeout, httpclient.HTTPException, OSError) as err:
            reason = getattr(err, "reason", None) or err
            die(f"Could not reach {api_base()}: {reason}.", {"error": "network", "message": str(reason)})
        finally:
            if fh:
                fh.close()
        if (status == 429 or (status == 503 and method == "GET")) and attempt < 2:
            try:
                wait = int(res.headers.get("Retry-After") or 2)
            except ValueError:
                wait = 2
            if wait <= 10:
                time.sleep(max(wait, 1))
                continue
        return Resp(status, res.headers, raw)
    return Resp(0, {}, b"")


def fail(resp: Resp) -> None:
    data = resp.json()
    if not isinstance(data, dict) or not data:
        text = resp.body.decode("utf-8", "replace").strip() if resp.body else ""
        data = {"error": f"http_{resp.status}", "message": clip(text, 200) if text else f"The API returned HTTP {resp.status}."}
    message = data.get("message") or data.get("error") or f"The API returned HTTP {resp.status}."
    rid = data.get("request_id") or (resp.headers.get("X-Request-Id") if resp.headers else None)
    if resp.status >= 500 and rid:
        message += f" (request {rid})"
    if JSON:
        show_json(data)
    print(f"berth: {message}", file=sys.stderr)
    raise SystemExit(1)


def check(resp: Resp) -> dict:
    if not resp.ok:
        fail(resp)
    data = resp.json()
    if data is None:
        return {"body": resp.body.decode("utf-8", "replace")}
    return data if isinstance(data, dict) else {"data": data}


def api(method: str, path: str, token: str | None, **kw) -> dict:
    return check(http(method, path, token, **kw))


def app_http(app: str, method: str, path: str, **kw) -> Resp:
    tokens = app_tokens(app)
    resp = None
    for i, token in enumerate(tokens):
        resp = http(method, path, token, **kw)
        if resp.status != 401 or i == len(tokens) - 1:
            return resp
        if resp.stream:
            resp.stream.close()
    return resp


def app_api(app: str, method: str, path: str, **kw) -> dict:
    return check(app_http(app, method, path, **kw))


def save_stream(resp: Resp, dest: str) -> int:
    total = 0
    src = resp.stream
    if dest == "-":
        out = sys.stdout.buffer
        while True:
            chunk = src.read(1 << 16)
            if not chunk:
                break
            out.write(chunk)
            total += len(chunk)
        out.flush()
        src.close()
        return total
    part = dest + ".part"
    try:
        with open(part, "wb") as fh:
            while True:
                chunk = src.read(1 << 16)
                if not chunk:
                    break
                fh.write(chunk)
                total += len(chunk)
    except (OSError, httpclient.HTTPException) as err:
        try:
            os.remove(part)
        except OSError:
            pass
        die(f"Download failed: {err}.")
    finally:
        src.close()
    os.replace(part, dest)
    return total


def file_arg(path: str) -> Path:
    p = Path(path).expanduser()
    if not p.is_file():
        usage(f"No such file: {path}")
    return p


# Values, filters, schema

def table_schema(app: str, table: str) -> dict:
    payload = app_api(app, "GET", app_path(app, "tables", table))
    info = payload.get("table") or payload
    return {c.get("name"): str(c.get("type") or "text") for c in info.get("columns") or []}


def coerce(col: str, ctype: str, raw: str):
    if raw == "null":
        return None
    t = ctype.lower().strip()
    if t in INT_TYPES:
        if not re.fullmatch(r"-?\d+", raw):
            usage(f"Column {col} is {ctype}, so {raw!r} must be a whole number.")
        return int(raw)
    if t in NUM_TYPES:
        if not NUMBER_RE.fullmatch(raw):
            usage(f"Column {col} is {ctype}, so {raw!r} must be a number.")
        return int(raw) if re.fullmatch(r"-?\d+", raw) else float(raw)
    if t == "boolean":
        if raw.lower() not in ("true", "false"):
            usage(f"Column {col} is boolean, so use true or false.")
        return raw.lower() == "true"
    if t in ("jsonb", "json") or t.endswith("[]"):
        try:
            return json.loads(raw)
        except ValueError:
            if t.endswith("[]"):
                return [] if raw == "" else raw.split(",")
            return raw
    return raw


def parse_assignments(items: list, schema: dict | None) -> dict:
    out = {}
    for item in items:
        if "=" not in item:
            usage(f"Write values as column=value, not {item!r}.")
        key, raw = item.split("=", 1)
        if schema is not None:
            if key not in schema:
                usage(f"The table has no column {key!r}. Columns: {', '.join(schema)}.")
            out[key] = coerce(key, schema[key], raw)
        else:
            out[key] = raw
    return out


def parse_where(items: list | None) -> list:
    query = []
    for item in items or []:
        if "=" not in item:
            usage(f"Write filters as column.op=value, for example age.gt=30. Got {item!r}.")
        left, value = item.split("=", 1)
        if "." not in left:
            if RAW_FILTER_RE.match(value):
                query.append((left, value))
                continue
            col, op = left, "eq"
        else:
            col, op = left.split(".", 1)
        base = op[4:] if op.startswith("not.") else op
        if base not in FILTER_OPS or not col:
            usage(f"Unknown filter {op!r}. Use one of: {', '.join(FILTER_OPS)}, or not.OP.")
        if base == "in" and not value.startswith("("):
            value = f"({value})"
        query.append((col, f"{op}.{value}"))
    return query


def json_input(data: str | None, file: str | None):
    if data is not None and file is not None:
        usage("Use --data or --file, not both.")
    try:
        if data is not None:
            return json.loads(data)
        if file == "-":
            return json.loads(sys.stdin.read())
        if file is not None:
            return json.loads(file_arg(file).read_text(encoding="utf-8"))
    except ValueError as err:
        usage(f"That is not valid JSON: {err}.")
    return None


def default_literal(ctype: str | None, raw: str):
    if raw in ("now()", "gen_random_uuid()", "current_date", "auth.uid()"):
        return raw
    if ctype:
        return coerce("default", ctype, raw)
    try:
        return json.loads(raw)
    except ValueError:
        return raw


def split_csv(value: str | None) -> list | None:
    if value is None:
        return None
    return [v.strip() for v in value.split(",") if v.strip()]


def row_rows(payload: dict) -> list:
    rows = payload.get("rows")
    if isinstance(rows, list):
        return rows
    return [payload["row"]] if isinstance(payload.get("row"), dict) else []


# Account commands

def finish_email_login(email: str, code: str | None) -> None:
    if not code:
        code = prompt("Code from the email: ")
    if not code:
        usage("Enter the 6 digit code from the email, or pass --code.")
    body = {"email": email, "code": code, "key_name": f"berth cli on {socket.gethostname()}"}
    payload = api("POST", "/login", None, body=body)
    key = payload.get("key")
    if not key:
        die("The API did not return a key.", payload)
    cfg()["token"] = key
    save_config()
    email = (payload.get("account") or {}).get("email") or email
    emit(payload, f"Logged in as {email}. Account key saved to {config_path()}.")


def ask_email(args) -> str:
    email = args.email or prompt("Email: ")
    if not email or "@" not in email:
        usage("Enter a valid email address.")
    return email


def cmd_signup(args) -> None:
    email = ask_email(args)
    if not args.code:
        api("POST", "/signup", None, body={"email": email})
        note(f"Sent a 6 digit code to {email}.")
    finish_email_login(email, args.code)


def cmd_login(args) -> None:
    if args.token is not None or (not args.email and not sys.stdin.isatty()):
        token = args.token
        if token in (None, "-"):
            token = sys.stdin.read()
        token = (token or "").strip()
        if not token:
            usage("Pass a key with --token, or pipe one on stdin.")
        payload = api("GET", "/me", token)
        role = payload.get("role") or "unknown"
        app = (payload.get("app") or {}).get("slug") or (payload.get("app") or {}).get("name")
        if role in ("secret", "publishable") and app:
            save_app_keys(app, **{role: token})
            if not cfg().get("default_app"):
                cfg()["default_app"] = app
                save_config()
            emit(payload, f"Saved the {role} key for {app} to {config_path()}.")
            return
        cfg()["token"] = token
        save_config()
        emit(payload, f"Logged in. role: {role}")
        return
    email = ask_email(args)
    if not args.code:
        api("POST", "/login", None, body={"email": email})
        note(f"Sent a 6 digit code to {email}.")
    finish_email_login(email, args.code)


def cmd_logout(args) -> None:
    data = cfg()
    had = bool(data.get("token"))
    data["token"] = ""
    if args.all:
        data["apps"] = {}
        data.pop("default_app", None)
    save_config()
    msg = "Logged out." if had else "Already logged out."
    if not args.all and data["apps"]:
        msg += f" Kept saved keys for {plural(len(data['apps']), 'app')}. Use --all to remove them."
    emit({"logged_out": True}, msg)


def cmd_whoami(_args) -> None:
    payload = api("GET", "/me", account_token())

    def human():
        print(f"role: {payload.get('role')}")
        for part in ("account", "app", "user", "key"):
            obj = payload.get(part)
            if isinstance(obj, dict):
                label = obj.get("email") or obj.get("slug") or obj.get("name") or obj.get("id")
                print(f"{part}: {label}")
        print(f"api: {api_base()}")
    emit(payload, human)


def cmd_status(_args) -> None:
    payload = api("GET", "/status", None)
    emit(payload, lambda: (print_kv(payload), print(f"api: {api_base()}")))


def cmd_account_show(_args) -> None:
    payload = api("GET", "/account", account_token())
    emit(payload, lambda: print_kv(payload.get("account") or payload))


def cmd_account_delete(args) -> None:
    payload = api("DELETE", "/account", account_token(), query=[("confirm", args.confirm)])
    cfg()["token"] = ""
    cfg()["apps"] = {}
    cfg().pop("default_app", None)
    save_config()
    emit(payload, f"Deleted the account {args.confirm} and all its apps.")


def cmd_account_keys_list(_args) -> None:
    payload = api("GET", "/account/keys", account_token())
    emit(payload, lambda: print_table(first_list(payload, "keys"), empty="No account keys."))


def cmd_account_keys_create(args) -> None:
    payload = api("POST", "/account/keys", account_token(), body={"name": args.name})

    def human():
        key = payload.get("key") or {}
        print(f"Created account key {key.get('name', args.name)} ({key.get('id', '')}).")
        print("Save it now. It is shown once:")
        print(payload.get("secret", ""))
    emit(payload, human)


def cmd_account_keys_revoke(args) -> None:
    payload = api("DELETE", seg("account", "keys", args.key_id), account_token())
    emit(payload, f"Revoked account key {args.key_id}.")


# Admin commands

def cmd_admin_accounts_list(_args) -> None:
    payload = api("GET", "/admin/accounts", account_token())
    emit(payload, lambda: print_table(first_list(payload, "accounts"), empty="No accounts."))


def cmd_admin_accounts_show(args) -> None:
    payload = api("GET", seg("admin", "accounts", args.account_id), account_token())
    emit(payload, lambda: print_kv(payload.get("account") or payload))


def cmd_admin_accounts_update(args) -> None:
    body: dict = {}
    if args.limit:
        body["limits"] = {}
        for item in args.limit:
            if "=" not in item:
                usage("Write limits as name=value, for example apps=10.")
            key, raw = item.split("=", 1)
            body["limits"][key] = int(raw) if re.fullmatch(r"-?\d+", raw) else raw
    if args.disabled is not None:
        body["disabled"] = args.disabled
    if not body:
        usage("Pass --limit NAME=VALUE, --disable, or --enable.")
    payload = api("PATCH", seg("admin", "accounts", args.account_id), account_token(), body=body)
    emit(payload, lambda: print_kv(payload.get("account") or payload))


def cmd_admin_accounts_delete(args) -> None:
    if not args.yes:
        usage("Deleting an account removes all its apps. Add --yes to confirm.")
    payload = api("DELETE", seg("admin", "accounts", args.account_id), account_token())
    emit(payload, f"Deleted account {args.account_id}.")


def cmd_admin_codes(args) -> None:
    query = [("email", args.email)] + ([("app", args.app_slug)] if args.app_slug else [])
    payload = api("GET", "/admin/codes", account_token(), query=query)
    emit(payload, lambda: print_kv(payload))


# Apps and keys

def print_new_keys(slug: str, keys: dict) -> None:
    print(f"Keys for {slug}, saved to {config_path()}. Shown once:")
    if keys.get("secret"):
        print(f"  secret:      {keys['secret']}  (server only, never ship it in an app)")
    if keys.get("publishable"):
        print(f"  publishable: {keys['publishable']}  (safe for phone and browser builds)")


def remember_created(payload: dict, fallback: str) -> str:
    app = payload.get("app") or {}
    slug = app.get("slug") or app.get("name") or fallback
    keys = payload.get("keys") or {}
    save_app_keys(slug, secret=keys.get("secret"), publishable=keys.get("publishable"))
    return slug


def cmd_apps_list(_args) -> None:
    payload = api("GET", "/apps", account_token())
    default = cfg().get("default_app")

    def human():
        apps = first_list(payload, "apps")
        rows = [{"slug": a.get("slug"), "name": a.get("name"), "created_at": a.get("created_at"),
                 "default": "*" if a.get("slug") == default else ""} for a in apps]
        print_table(rows, empty="No apps yet. Create one with berth apps create NAME.")
    emit(payload, human)


def cmd_apps_create(args) -> None:
    payload = api("POST", "/apps", account_token(), body={"name": args.name})
    slug = remember_created(payload, args.name)

    def human():
        print(f"Created app {slug}.")
        url = (payload.get("app") or {}).get("api_url")
