SKIP_DIRS = {".git", "node_modules", ".DS_Store", ".next/cache", ".vercel", ".netlify"}


def site_files(root: Path) -> dict:
    files = {}
    for path in sorted(root.rglob("*")):
        rel = path.relative_to(root).as_posix()
        parts = rel.split("/")
        if any(p.startswith(".") and p != ".well-known" for p in parts) or "node_modules" in parts:
            continue
        if path.is_symlink():
            usage(f"{rel} is a symlink. Deploy real files.")
        if path.is_file():
            files[rel] = path
    return files


def sha256_file(path: Path) -> str:
    import hashlib
    h = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def human_bytes(n: int) -> str:
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return str(n)


