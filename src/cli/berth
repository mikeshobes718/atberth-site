def main(argv: list | None = None) -> None:
    global JSON, API_OVERRIDE, IDEMPOTENCY_KEY
    argv = sys.argv[1:] if argv is None else argv
    parser = build_parser()
    if not argv:
        parser.print_help()
        return
    args, extras = parser.parse_known_args(argv)
    if extras:
        target = getattr(args, "_extra", None)
        if target and not any(e.startswith("-") and not NUMBER_RE.fullmatch(e) for e in extras):
            setattr(args, target, list(getattr(args, target) or []) + extras)
        else:
            parser.error("unrecognized arguments: " + " ".join(extras))
    JSON = bool(getattr(args, "json", False))
    API_OVERRIDE = getattr(args, "api", None)
    IDEMPOTENCY_KEY = getattr(args, "idempotency_key", None)
    if not hasattr(args, "func"):
        parser.print_help(sys.stderr)
        raise SystemExit(2)
    args.func(args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        raise SystemExit(130)
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except OSError:
            pass
        raise SystemExit(0)
