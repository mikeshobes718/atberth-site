def rows_path(app: str, table: str, *rest) -> str:
    return app_path(app, "tables", table, "rows", *rest)


def cmd_rows_list(args) -> None:
    app = resolve_app(args)
    query = parse_where(args.where)
    if args.select:
        query.append(("select", args.select))
    if args.order:
        query.append(("order", args.order))
    limit = args.limit if args.limit is not None else (1000 if args.all else None)
    if limit is not None:
        query.append(("limit", str(limit)))
    if args.offset is not None:
        query.append(("offset", str(args.offset)))
    if args.count:
        query.append(("count", "exact"))
    path = rows_path(app, args.table)
    if args.all:
        rows: list = []
        cursor = args.cursor
        count = None
        while True:
            page = app_api(app, "GET", path, query=query + ([("cursor", cursor)] if cursor else []))
            rows.extend(page.get("rows") or [])
            count = page.get("count", count)
            cursor = page.get("next_cursor")
            if not cursor:
                break
        payload: dict = {"rows": rows, "next_cursor": None}
        if count is not None:
            payload["count"] = count
    else:
        if args.cursor:
            query.append(("cursor", args.cursor))
        payload = app_api(app, "GET", path, query=query)

    def human():
        print_table(payload.get("rows") or [], empty="No rows.")
        if payload.get("count") is not None:
            print(f"count: {payload['count']}")
        if payload.get("next_cursor"):
            note(f"More rows. Next page: --cursor {payload['next_cursor']}  (or use --all)")
    emit(payload, human)


def insert_body(args, app: str, table: str):
    body = json_input(args.data, args.file)
    if body is not None:
        if args.values:
            usage("Use column=value pairs or --data/--file, not both.")
        if not isinstance(body, (dict, list)):
            usage("--data must be a JSON object or an array of objects.")
        return body
    if not args.values:
        usage("Pass column=value pairs, --data JSON, or --file rows.json.")
    return parse_assignments(args.values, table_schema(app, table))


def send_rows(app: str, table: str, body, query: list | None = None) -> dict:
    path = rows_path(app, table)
    if isinstance(body, list) and len(body) > 1000:
        out: list = []
        for start in range(0, len(body), 1000):
            page = app_api(app, "POST", path, body=body[start:start + 1000], query=query)
            out.extend(page.get("rows") or [])
        return {"rows": out}
    return app_api(app, "POST", path, body=body, query=query)


