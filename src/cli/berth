# SQL, logs, raw API

def cmd_sql(args) -> None:
    app = resolve_app(args)
    if args.file and args.query:
        usage("Pass a query or -f FILE, not both.")
    if args.file:
        query = sys.stdin.read() if args.file == "-" else file_arg(args.file).read_text(encoding="utf-8")
    else:
        query = args.query
    if not query or not query.strip():
        usage('Pass a query, for example berth sql --app demo "select 1".')
    body: dict = {"query": query}
    if args.param:
        body["params"] = args.param
    if args.read_only:
        body["read_only"] = True
    if args.timeout_ms is not None:
        body["timeout_ms"] = args.timeout_ms
    payload = app_api(app, "POST", app_path(app, "sql"), body=body)

    def human():
        cols = [c.get("name") if isinstance(c, dict) else str(c) for c in payload.get("columns") or []]
        rows = payload.get("rows") or []
        if cols:
            shaped = [r if isinstance(r, dict) else dict(zip(cols, r)) for r in rows]
            print_table(shaped, cols, empty="(no rows)")
        tail = f"{payload.get('command', '')} {payload.get('row_count', '')}".strip()
        if payload.get("truncated"):
            tail += " (truncated to the first 1000 rows)"
        print(tail)
    emit(payload, human)


def cmd_rpc(args) -> None:
    app = resolve_app(args)
    body: dict = {}
    if args.data:
        try:
            body = json.loads(args.data)
        except ValueError:
            usage("--data must be a JSON object.")
        if not isinstance(body, dict):
            usage("--data must be a JSON object.")
    for pair in args.arg or []:
        key, sep, value = pair.partition("=")
        if not sep or not key:
            usage(f"Write arguments as name=value, not {pair}.")
        try:
            body[key] = json.loads(value)
        except ValueError:
            body[key] = value
    payload = app_api(app, "POST", app_path(app, "rpc", args.function), body=body)
    if isinstance(payload, dict) and set(payload) == {"data"}:
        payload = payload["data"]
    elif isinstance(payload, dict) and set(payload) == {"body"} and payload["body"].strip() == "null":
        payload = None

    def human():
        if isinstance(payload, list) and payload and all(isinstance(r, dict) for r in payload):
            print_table(payload)
        else:
            print(json.dumps(payload, indent=2, ensure_ascii=False))
    emit(payload, human)


def cmd_logs(args) -> None:
    app = resolve_app(args)
    query = []
    if args.limit:
        query.append(("limit", str(args.limit)))
    if args.status:
        query.append(("status", args.status))
    payload = app_api(app, "GET", app_path(app, "logs"), query=query or None)
    cols = ["created_at", "method", "path", "status", "duration_ms", "key_type", "request_id"]
    emit(payload, lambda: print_table(first_list(payload, "logs"), cols, empty="No requests logged."))


def cmd_api(args) -> None:
    path = args.path if args.path.startswith("/") else "/" + args.path
    if path.startswith("/v1/"):
        path = path[3:]
    body = json_input(args.data, None)
    kw: dict = {"body": body} if body is not None else {}
    method = args.method.upper()
    resp = app_http(args.app, method, path, **kw) if args.app else http(method, path, account_token(False) or None, **kw)
    payload = check(resp)
    show_json(payload)


# Completion

def command_tree(parser: argparse.ArgumentParser, prefix: list, tree: dict) -> None:
    words = []
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            for name, sub in action.choices.items():
                words.append(name)
                command_tree(sub, prefix + [name], tree)
        else:
            words.extend(o for o in action.option_strings if o.startswith("--"))
    tree[" ".join(prefix)] = words


def cmd_completion(args) -> None:
    tree: dict = {}
    command_tree(build_parser(), [], tree)
    cases = "\n".join(f'    "{k}") echo "{" ".join(v)}" ;;' for k, v in sorted(tree.items()))
    script = f"""# berth {args.shell} completion. Load it with: eval "$(berth completion {args.shell})"
_berth_words() {{
  case "$1" in
{cases}
  esac
}}
_berth() {{
  local cur path w i words
  cur="${{COMP_WORDS[COMP_CWORD]}}"
  path=""
  for ((i=1; i<COMP_CWORD; i++)); do
    w="${{COMP_WORDS[i]}}"
    case "$w" in -*) continue ;; esac
    words=" $(_berth_words "$path") "
    case "$words" in *" $w "*) path="${{path:+$path }}$w" ;; esac
  done
  COMPREPLY=( $(compgen -W "$(_berth_words "$path")" -- "$cur") )
}}
"""
    if args.shell == "zsh":
        script += "autoload -U +X bashcompinit && bashcompinit\n"
    script += "complete -o default -F _berth berth\n"
    sys.stdout.write(script)


# Parser

class Fmt(argparse.RawDescriptionHelpFormatter):
    def __init__(self, prog):
        super().__init__(prog, max_help_position=32)


def common_parent() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(add_help=False)
    g = p.add_argument_group("global options")
    g.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="Print the raw API JSON.")
    g.add_argument("--api", metavar="URL", default=argparse.SUPPRESS, help="API base URL for this run.")
    g.add_argument("--idempotency-key", metavar="KEY", default=argparse.SUPPRESS,
                   help="Send Idempotency-Key so a retried write is not applied twice.")
    return p


COMMON = common_parent()


def examples(lines) -> str:
    if isinstance(lines, str):
        lines = [lines]
    return "Example:\n" + "\n".join("  " + line for line in lines)


def group(sub, name: str, summary: str, example) -> argparse._SubParsersAction:
    p = sub.add_parser(name, help=summary, description=summary, epilog=examples(example),
                       formatter_class=Fmt, parents=[COMMON])
    inner = p.add_subparsers(title="commands", metavar="COMMAND")

    def show_help(_args, parser=p):
        parser.print_help(sys.stderr)
        raise SystemExit(2)
    p.set_defaults(func=show_help)
    return inner


def cmd(sub, name: str, func, summary: str, example, extra: str | None = None) -> argparse.ArgumentParser:
    p = sub.add_parser(name, help=summary, description=summary, epilog=examples(example),
                       formatter_class=Fmt, parents=[COMMON])
    p.set_defaults(func=func, _extra=extra)
    return p


def app_opt(p: argparse.ArgumentParser) -> None:
    p.add_argument("--app", "-a", metavar="APP", help="App slug. Defaults to BERTH_APP or the app set with berth use.")


def yes_opt(p: argparse.ArgumentParser, what: str) -> None:
    p.add_argument("--yes", "-y", action="store_true", help=f"Confirm that you want to {what}.")


