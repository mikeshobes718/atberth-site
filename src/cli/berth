def cmd_sites_deploy(args) -> None:
    from concurrent.futures import ThreadPoolExecutor
    app = resolve_app(args)
    root = Path(args.dir).expanduser()
    if not root.is_dir():
        usage(f"{args.dir} is not a folder. Point at your build output, like ./dist, ./build, or ./out.")
    files = site_files(root)
    if not files:
        usage(f"{args.dir} has no files to deploy.")
    if "index.html" not in files:
        note(f"Note: {args.dir} has no index.html at the top, so the home page will be a 404.")
    name = args.site or root.resolve().name.lower().replace("_", "-")
    resp = app_http(app, "GET", app_path(app, "sites", name))
    if resp.status == 404:
        app_api(app, "POST", app_path(app, "sites"), body={"name": name})
        note(f"Created site {name}.")
    elif not resp.ok:
        fail(resp)
    hashes = {rel: sha256_file(path) for rel, path in files.items()}
    by_sha = {sha: files[rel] for rel, sha in hashes.items()}
    total = sum(p.stat().st_size for p in files.values())
    body = {"files": hashes, "preview": bool(args.preview)}
    if args.message:
        body["message"] = args.message
    start = app_api(app, "POST", app_path(app, "sites", name, "deploys"), body=body, timeout=120)
    deploy_id = start["deploy"]["id"]
    missing = start.get("missing") or []
    if not JSON:
        note(f"{plural(len(files), 'file')}, {human_bytes(total)}. Uploading {plural(len(missing), 'new file')}.")

    def upload(sha: str) -> None:
        r = app_http(app, "PUT", app_path(app, "sites", name, "files", sha), data=by_sha[sha],
                     ctype="application/octet-stream", timeout=300)
        if not r.ok:
            fail(r)
    with ThreadPoolExecutor(max_workers=8) as pool:
        list(pool.map(upload, missing))
    payload = app_api(app, "POST", app_path(app, "sites", name, "deploys", deploy_id, "finish"), body={}, timeout=180)

    def human():
        for w in payload["deploy"].get("warnings") or []:
            note("Warning: " + w)
        if args.preview:
            print(f"Preview ready: {payload['url']}")
            print(f"Make it live: berth sites promote {name} {deploy_id}")
        else:
            print(f"Live: {payload['url']}")
            print(f"This deploy: {payload['deploy']['url']}")
    emit(payload, human)


